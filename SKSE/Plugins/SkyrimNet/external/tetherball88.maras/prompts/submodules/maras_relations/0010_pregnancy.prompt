{% if ttm_is_registered(actorUUID) %}
    {% set npcName = decnpc(actorUUID).name %}
    {% set profile = ttm_npc_relationship_profile(actorUUID) %}
    {% if existsIn(profile, "is_pregnant") and profile.is_pregnant %}
        ## {{npcName}}'s pregnancy
        {% set preg = profile.pregnancy %}
        {% if existsIn(preg, "child_count") and preg.child_count > 1 and existsIn(preg, "groups") and length(preg.groups) > 0 %}
            {{npcName}} is currently pregnant with {{preg.child_count}} children{% if existsIn(preg, "mother_partner") and preg.mother_partner.name != "" %}; {{preg.mother_partner.name}} is her partner{% endif %}.
            {%- for grp in preg.groups %}
                {%- if existsIn(grp.bio_father, "name") and grp.bio_father.name != "Unknown" %}
                    {%- set bioName = grp.bio_father.name %}
                {%- else %}
                    {%- set bioName = "an unknown father" %}
                {%- endif %}
                {%- if grp.is_mother_partner %}
                    {% if grp.count == 1 %} 1 child is from {{bioName}}.{% else %} {{grp.count}} children are from {{bioName}}.{% endif %}
                {%- elif existsIn(preg, "mother_partner") and preg.mother_partner.name != "" %}
                    {%- set partnerName = preg.mother_partner.name %}
                    {%- if grp.is_secret_for_partner and grp.is_secret_for_bio_father %}
                        {% if grp.count == 1 %} 1 child was fathered by {{bioName}}{% else %} {{grp.count}} children were fathered by {{bioName}}{% endif %}, and {{npcName}} has not told either her partner {{partnerName}} or {{bioName}} that {{bioName}} is the biological father.
                    {%- elif grp.is_secret_for_partner %}
                        {% if grp.count == 1 %} 1 child was fathered by {{bioName}}{% else %} {{grp.count}} children were fathered by {{bioName}}{% endif %}; {{bioName}} knows he is the biological father, but {{npcName}} is keeping the true paternity hidden from her partner {{partnerName}}.
                    {%- elif grp.is_secret_for_bio_father %}
                        {% if grp.count == 1 %} 1 child was fathered by {{bioName}}{% else %} {{grp.count}} children were fathered by {{bioName}}{% endif %}; her partner {{partnerName}} knows the truth, but {{bioName}} has not been told that he is the father.
                    {%- elif bioName != "an unknown father" and partnerName != bioName %}
                        {% if grp.count == 1 %} 1 child is from {{bioName}}{% else %} {{grp.count}} children are from {{bioName}}{% endif %}, though {{partnerName}} is her partner; the true biological paternity is known to both {{partnerName}} and {{bioName}}.
                    {%- else %}
                        {% if grp.count == 1 %} 1 child is from {{bioName}}.{% else %} {{grp.count}} children are from {{bioName}}.{% endif %}
                    {%- endif %}
                {%- elif grp.is_secret %}
                    {% if grp.count == 1 %} 1 child is from {{bioName}}{% else %} {{grp.count}} children are from {{bioName}}{% endif %}, but it is a secret as of now.
                {%- else %}
                    {% if grp.count == 1 %} 1 child is from {{bioName}}.{% else %} {{grp.count}} children are from {{bioName}}.{% endif %}
                {%- endif %}
            {%- endfor %}
        {% elif existsIn(profile, "pregnancy") and existsIn(profile.pregnancy, "is_secret") and profile.pregnancy.is_secret %}
            {% if existsIn(preg, "bio_father") and preg.bio_father.name != "Unknown" %}
                {% set bioName = preg.bio_father.name %}
            {% else %}
                {% set bioName = "unknown" %}
            {% endif %}
            {% if existsIn(preg, "mother_partner") and existsIn(preg.mother_partner, "name") and preg.mother_partner.name != "" and preg.mother_partner.name != bioName %}
                {% if existsIn(preg, "is_secret_for_partner") and existsIn(preg, "is_secret_for_bio_father") and preg.is_secret_for_partner and preg.is_secret_for_bio_father %}
                    {{npcName}} is currently pregnant with a child fathered by {{bioName}} (while {{preg.mother_partner.name}} is her partner). {{npcName}} has not told either {{preg.mother_partner.name}} or {{bioName}} that {{bioName}} is the child's biological father.
                {% elif existsIn(preg, "is_secret_for_partner") and preg.is_secret_for_partner %}
                    {{npcName}} is currently pregnant with a child fathered by {{bioName}} (while {{preg.mother_partner.name}} is her partner). {{bioName}} knows he is the biological father, but {{npcName}} is keeping the true paternity hidden from {{preg.mother_partner.name}}.
                {% elif existsIn(preg, "is_secret_for_bio_father") and preg.is_secret_for_bio_father %}
                    {{npcName}} is currently pregnant with a child fathered by {{bioName}} (while {{preg.mother_partner.name}} is her partner). {{preg.mother_partner.name}} knows the truth, but {{bioName}} has not been told that he is the father.
                {% else %}
                    {{npcName}} is currently pregnant with a child fathered by {{bioName}}, though {{preg.mother_partner.name}} is her partner. Both {{preg.mother_partner.name}} and {{bioName}} are aware of the true biological paternity.
                {% endif %}
            {% elif existsIn(preg, "mother_partner") and existsIn(preg.mother_partner, "name") and preg.mother_partner.name != "" %}
                {{npcName}} is currently pregnant with child with {{preg.mother_partner.name}}.
            {% else %}
                {{npcName}} is currently pregnant with child{% if bioName != "unknown" %} fathered by {{bioName}}{% endif %}.
            {% endif %}
        {% elif existsIn(profile, "pregnancy") and existsIn(profile.pregnancy, "has_paternity_secret") and profile.pregnancy.has_paternity_secret and existsIn(profile.pregnancy, "mother_partner") and existsIn(profile.pregnancy, "bio_father") and profile.pregnancy.bio_father.name != "Unknown" and profile.pregnancy.mother_partner.name != profile.pregnancy.bio_father.name %}
            {{npcName}} is currently pregnant with child fathered by {{profile.pregnancy.bio_father.name}}, though {{profile.pregnancy.mother_partner.name}} is her partner; the true biological paternity is known to both {{profile.pregnancy.mother_partner.name}} and {{profile.pregnancy.bio_father.name}}.
        {% elif existsIn(profile, "pregnancy") and existsIn(profile.pregnancy, "mother_partner") and existsIn(profile.pregnancy.mother_partner, "name") and profile.pregnancy.mother_partner.name != "" %}
            {{npcName}} is currently pregnant with child with {{profile.pregnancy.mother_partner.name}}.
        {% elif existsIn(profile, "pregnancy") and existsIn(profile.pregnancy, "bio_father") and existsIn(profile.pregnancy.bio_father, "name") and profile.pregnancy.bio_father.name != "Unknown" %}
            {{npcName}} is currently pregnant with child fathered by {{profile.pregnancy.bio_father.name}}.
        {% else %}
            {{npcName}} is currently pregnant with child.
        {% endif %}
    {% endif %}
{% endif %}
