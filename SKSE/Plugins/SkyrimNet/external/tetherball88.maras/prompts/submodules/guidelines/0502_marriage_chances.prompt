{% if not isTimePaused and is_in_faction(npc.UUID, "TTM_TrackedNpcs") and render_mode == "full" and not decnpc(npc.UUID).isVirtual %}
    {% set npcName = decnpc(npc.UUID).name %}
    {% set factionRank = get_faction_rank(npc.UUID, "TTM_TrackedNpcs") %}
    {% if factionRank != 1 and factionRank != 2 %}
        ### Marriage Proposal Response Guidelines
        {% set allowPolygamy = false %}
        {% if get_global_value("TTM_EnablePolygamyToggle") == 1.0 %}
            {% set allowPolygamy = true %}
            {{player.name}} is known to walk a blessed path, one that allows multiple spouses through divine sanction. Most who understand this view it with respect, not judgment.
            {% if get_global_value("TTM_LoveInterestsCount") >= 1.0 %}
                {% set playerProfile = ttm_npc_relationship_profile(player.UUID) %}
                {% set spouses = [] %}
                {% set fiances = [] %}
                {% for rel in playerProfile.current_relationships %}
                    {% if rel.status == "married" %}
                        {% set spouses = append(spouses, rel.partner.name) %}
                    {% elif rel.status == "engaged" %}
                        {% set fiances = append(fiances, rel.partner.name) %}
                    {% endif %}
                {% endfor %}
                {% if length(spouses) > 0 and render_mode == "full" %}{{player.name}} is married to {{join(spouses, ", ")}}.{% endif %}
                {% if length(fiances) > 0 and render_mode == "full" %}{{player.name}} is currently engaged with {{join(fiances, ", ")}}.{% endif %}
            {% endif %}
        {% endif %}
        {% set datingPartner = ttm_get_dating_partner(npc.UUID) %}
        {% if datingPartner != "" and datingPartner != player.name %}
            {{npcName}} is currently in a committed dating relationship with {{datingPartner}} and will decline any marriage/engagement proposal from {{player.name}}.
        {% elif not allowPolygamy and get_global_value("TTM_LoveInterestsCount") >= 1.0 %}
            {{npcName}} will respond with confusion - {{player.name}} is already committed.
        {% else %}
            If {{player.name}} proposes engagement to {{npcName}}, {{npcName}} will consider the proposal carefully, taking into account their feelings, the current relationship status, and any existing commitments.
        {% endif %}
    {% endif %}
{% endif %}

