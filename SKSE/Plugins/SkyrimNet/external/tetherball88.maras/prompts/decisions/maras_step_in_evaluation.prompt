[ state paternity_situation ]
{% if formerSpouseUUID != 0 %}
Evaluate an ongoing paternity situation following a divorce in Skyrim:
- Mother: {{ motherName }} ({{ motherRace }})
- Former Spouse (ex-partner): {{ formerSpouseName }} ({{ formerSpouseRace }})
- True Biological Father: {{ bioFatherName }} ({{ bioFatherRace }})
{% else %}
Evaluate an ongoing paternity situation in Skyrim:
- Mother: {{ motherName }} ({{ motherRace }})
- True Biological Father: {{ bioFatherName }} ({{ bioFatherRace }})
{% endif %}
{% if isPregnancy %}
- Child / Pregnancy Context: {{ motherName }} is currently pregnant with {{ bioFatherName }}'s unborn child.
{% else %}
- Child: {{ childName }} (Age: {{ childAgeDays }} days)
{% endif %}
[ end state ]

[ state mother_profile ]
{% if motherUUID != 0 %}
{{ render_character_profile("ttm_gm", motherUUID) }}
{% else %}
{{ motherName }} ({{ motherRace }})
{% endif %}
[ end state ]

[ state bio_father_profile ]
{% if bioFatherUUID != 0 %}
{{ render_character_profile("ttm_gm", bioFatherUUID) }}
{% else %}
{{ bioFatherName }} ({{ bioFatherRace }})
{% endif %}
[ end state ]

{% if formerSpouseUUID != 0 %}
[ state former_spouse_profile ]
{{ render_character_profile("ttm_gm", formerSpouseUUID) }}
[ end state ]
{% endif %}

[ state recent_events_and_dialogues ]
{{ render_template("helpers\\maras_actor_bio_recent_events") }}
[ end state ]

[ state evaluation_guidelines ]
Evaluate the character profiles, personality traits, morality, existing relationships, and recent events/dialogues of {{ bioFatherName }} and {{ motherName }}.
{% if formerSpouseUUID != 0 %}
Now that {{ motherName }} is divorced from {{ formerSpouseName }}, determine whether {{ bioFatherName }} steps in to claim his biological child, marry {{ motherName }}, and take responsibility as a family.
{% else %}
Determine whether {{ bioFatherName }} steps in to claim his biological child, marry {{ motherName }}, and take responsibility as a family.
{% endif %}
[ end state ]

[ question bio_father_steps_in noul ]
Does {{ bioFatherName }} step forward to claim his biological child and marry {{ motherName }} to raise the child together as a family, with {{ motherName }} accepting?
[ criteria ]
true: {{ bioFatherName }} steps forward to claim his biological child and marries {{ motherName }} to raise the child together as a family, and {{ motherName }} accepts
false: {{ bioFatherName }} remains uninvolved, refuses commitment, or {{ motherName }} does not marry him
[ end criteria ]
[ end question ]

